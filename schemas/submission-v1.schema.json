{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "submission_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "text": {
      "type": "string",
      "maxLength": 1000000
    },
    "logger_evidence": {
      "type": "object"
    }
  },
  "required": [
    "submission_id",
    "plan_digest",
    "text",
    "logger_evidence"
  ],
  "additionalProperties": false
}
