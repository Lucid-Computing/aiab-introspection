{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "aiab-plan/v1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "parties": {
      "type": "object",
      "properties": {
        "lab_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "auditor_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        }
      },
      "required": [
        "lab_key",
        "auditor_key"
      ],
      "additionalProperties": false
    },
    "runtime_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input_scope": {
      "type": "object",
      "properties": {
        "logger_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "window_start": {
          "type": "string",
          "format": "date-time",
          "maxLength": 32
        },
        "window_end": {
          "type": "string",
          "format": "date-time",
          "maxLength": 32
        },
        "selection": {
          "const": "all"
        }
      },
      "required": [
        "logger_key",
        "window_start",
        "window_end",
        "selection"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "repo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "release_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+\\.tinfoil\\.dev$"
        },
        "temperature": {
          "const": 0
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 32,
          "maximum": 2048
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 131072
        }
      },
      "required": [
        "id",
        "artifact_digest",
        "repo",
        "release_digest",
        "host",
        "temperature",
        "max_output_tokens",
        "context_tokens"
      ],
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "properties": {
        "problem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "positive_examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "minItems": 1,
          "maxItems": 32
        },
        "negative_examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "minItems": 1,
          "maxItems": 32
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evaluation": {
          "type": "object",
          "properties": {
            "test_set_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "results_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "test_set_digest",
            "results_digest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "problem",
        "prompt",
        "positive_examples",
        "negative_examples",
        "threshold",
        "evaluation"
      ],
      "additionalProperties": false
    },
    "program": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "output_schema": {
      "type": "object"
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_input_utf8_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_model_calls": {
          "const": 1
        },
        "execution_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_result_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      },
      "required": [
        "max_input_utf8_bytes",
        "max_model_calls",
        "execution_timeout_seconds",
        "max_result_bytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "plan_id",
    "parties",
    "runtime_digest",
    "input_scope",
    "model",
    "classification",
    "program",
    "output_schema",
    "limits"
  ],
  "additionalProperties": false
}
