{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "report": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "aiab-report/v2"
            },
            "run_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "boot_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "plan_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "input_commitment": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "policy_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "status": {
              "const": "completed"
            },
            "result": {}
          },
          "required": [
            "schema",
            "run_id",
            "boot_id",
            "plan_digest",
            "input_commitment",
            "policy_digest",
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "aiab-report/v2"
            },
            "run_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "boot_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "plan_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "input_commitment": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "policy_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "status": {
              "const": "failed"
            },
            "error": {
              "enum": [
                "execution_failed",
                "model_unavailable",
                "invalid_output",
                "input_too_large"
              ]
            }
          },
          "required": [
            "schema",
            "run_id",
            "boot_id",
            "plan_digest",
            "input_commitment",
            "policy_digest",
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "signature": {
      "type": "string"
    }
  },
  "required": [
    "report",
    "signature"
  ],
  "additionalProperties": false
}
