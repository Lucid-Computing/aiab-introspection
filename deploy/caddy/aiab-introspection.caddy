# Import INSIDE the jonathan.quest site block. Keep existing sites and fallback
# handlers. The explicit slash boundary leaves unrelated apex paths untouched.
handle /aiab-introspection {
	redir * /aiab-introspection/ 308
}

handle /aiab-introspection/api {
	redir * /aiab-introspection/api/ 308
}

handle_path /aiab-introspection/api/* {
	request_body {
		max_size 1MB
	}
	reverse_proxy https://127.0.0.1:8443 {
		# Stock Caddy overload protection: four in-flight API requests in total.
		# No retry/queue: excess requests fail immediately with HTTP 503.
		unhealthy_request_count 4
		header_up -Cookie
		header_up -Authorization
		transport http {
			# AIAB rotates its self-signed local certificate at each boot.
			# This exception is ONLY for the loopback hop, never browser TLS.
			tls_insecure_skip_verify
			dial_timeout 3s
			response_header_timeout 45s
			read_timeout 45s
			write_timeout 15s
		}
	}
}

handle_path /aiab-introspection/* {
	# Only these public files belong to the UI; unknown application paths are 404.
	@aiab_ui path / /index.html /config.js /demo_prompts.json
	route {
		reverse_proxy @aiab_ui 127.0.0.1:8081 {
			header_up -Cookie
			header_up -Authorization
		}
		respond "Not found" 404
	}
}
