# Example only. Runtime settings are parsed once and frozen for each boot.
AIAB_MODE=local
AIAB_ID=aiab-dev
ENFORCEMENT_MODE=monitor
BLOCK_THRESHOLD=0.8
INFERENCE_URL=http://inference:8080
LISTEN_PORT=8443
CORS_ALLOW_ORIGIN=
SAMPLE_RATE=0.05
REPORT_PERIOD_SECONDS=600
REPORT_HISTORY=100
# Empty selects the development mock only in local mode.
TINFOIL_API_KEY=
# Empty selects gpt-oss-safeguard-120b with a key, mock-keywords/v1 without one.
CLASSIFIER_MODEL=
CLASSIFIER_DEFINITION=classifiers/ai_capabilities.md
LOG_LEVEL=INFO
# Webchat only:
AIAB_URL=https://localhost:8443
# Auditor only; required outside --insecure-local:
# Tinfoil release tinfoil.hash digest (64 hex), NOT an OCI image digest:
EXPECTED_AIAB_DIGEST=
EXPECTED_POLICY_DIGEST=
# CLASSIFIER_ENDPOINT_OVERRIDE is unsupported. Startup must reject it if set.
