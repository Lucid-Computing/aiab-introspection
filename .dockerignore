# Only reviewed runtime sources and dependency inputs enter the build context.
# The build context is the repository root; the static part lives under static/.
**
!static/
static/**
!static/pyproject.toml
!static/uv.lock
!static/aiab/
static/aiab/**
!static/aiab/*.py
!static/aiab/audit/
static/aiab/audit/**
!static/aiab/audit/*.py
!static/deploy/
static/deploy/**
!static/deploy/Dockerfile
!.dockerignore
!static/aiab/baked/
static/aiab/baked/**
!static/aiab/baked/*.py
!static/aiab/baked/trust.json
!plan/
plan/**
!plan/__init__.py
!plan/plan.py
!plan/plan.json
!plan/prompts/
plan/prompts/**
!plan/prompts/*.txt
!plan/signatures/
plan/signatures/**
!plan/signatures/lab.sig
!plan/signatures/auditor.sig
# Keep these exclusions last: reincluding a directory also includes descendants.
**/__pycache__
**/*.pyc
**/*.pyo
